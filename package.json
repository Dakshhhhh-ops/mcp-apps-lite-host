{
  "name": "mcp-apps-lite-host",
  "version": "0.2.0",
  "description": "Render MCP Apps (ext-apps) views in any web page: a dependency-free host with CSP, permissions, tool visibility and a sandbox proxy.",
  "type": "module",
  "main": "mcp-apps-host.js",
  "exports": {
    ".": "./mcp-apps-host.js",
    "./sandbox-proxy.html": "./sandbox-proxy.html"
  },
  "files": [
    "mcp-apps-host.js",
    "sandbox-proxy.html",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "ext-apps",
    "iframe",
    "postMessage",
    "sandbox",
    "csp"
  ],
  "license": "MIT",
  "author": "Daksh",
  "homepage": "https://github.com/Dakshhhhh-ops/mcp-apps-lite-host#readme",
  "bugs": {
    "url": "https://github.com/Dakshhhhh-ops/mcp-apps-lite-host/issues"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test test/host.test.js",
    "test:browser": "node --test test/browser.test.js",
    "example": "node test/serve.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dakshhhhh-ops/mcp-apps-lite-host"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "playwright": "1.64.1"
  }
}
